# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Generated by the test harnesses. web/tests/samples/ is deliberately NOT
# ignored: those files are committed as manual-test fixtures, are entirely
# synthetic, and are regenerated by the make_*_samples.mjs scripts.
web/tests/ref/
web/tests/_check.js

# Processed EDI output — may contain PHI, must never be committed.
# De-identified output is listed too: the run only rewrites the loops it
# recognises, so a file whose patient data sits somewhere unexpected comes out
# named "deidentified" while still carrying it.
*_processed_*.edi
*_lds_*.edi
*_deidentified_*.edi

# OS
Thumbs.db
desktop.ini
.DS_Store
